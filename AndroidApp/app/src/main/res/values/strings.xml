    <string name="app_name">Medya ve Belge İşleme</string>
    <string name="slogan_text">PAYLAŞILMAYAN BİLGİ, BİLGİ DEĞİLDİR.</string>
    <string name="hero_title">Medya ve Belge İşleme Merkezine Hoş Geldiniz</string>
    <string name="hero_subtitle">Yüksek performanslı sunucu motorlarıyla medya dosyalarınızı, ofis belgelerinizi ve OCR işlemlerinizi kayıpsız yönetin.</string>

