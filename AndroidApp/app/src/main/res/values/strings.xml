    <!-- Tools -->
    <string name="tool_v2a">Videodan Sese Dönüştür</string>
    <string name="tool_v2a_desc">Yüklediğiniz videonun sesini yüksek kalitede ayıklar (MP3, WAV, M4A, FLAC).</string>

    <string name="tool_a2a">Ses Formatı Değiştir</string>
    <string name="tool_a2a_desc">Ses kayıtlarınızı istediğiniz formata dönüştürün (MP3, WAV, AAC, OGG, FLAC).</string>

    <string name="tool_v2v">Video Formatı Değiştir &amp; GIF Yap</string>
    <string name="tool_v2v_desc">Videolarınızı dönüştürün veya belirlediğiniz saniye aralığında yüksek kaliteli hareketli GIF yapın.</string>

    <string name="tool_a2v">Sesten Video Oluştur</string>
    <string name="tool_a2v_desc">Ses kaydınıza bir kapak görseli ekleyerek sosyal medya uyumlu MP4 video üretin.</string>

    <string name="tool_i2i">Resim Formatı Değiştir</string>
    <string name="tool_i2i_desc">Görsellerinizi JPG, PNG, WEBP, ICO veya PDF formatına dönüştürün.</string>

    <string name="tool_vmerge">İki Videoyu Birleştir</string>
    <string name="tool_vmerge_desc">İki ayrı videoyu peş peşe ekleyerek tek bir MP4 videosu yapar (Maksimum 2 GB).</string>

    <string name="tool_amerge">İki Sesi Birleştir</string>
    <string name="tool_amerge_desc">İki ses kaydını uç uca ekleyerek tek bir ses dosyası oluşturur.</string>

    <string name="tool_doc_convert">Belge Dönüştürücü</string>
    <string name="tool_doc_convert_desc">Word, PDF, Markdown, EPUB, HTML, ODT, RTF, CSV ve metin dosyalarını birbirine çevirin.</string>

    <string name="tool_pdf_ocr">Taranmış PDF OCR</string>
    <string name="tool_pdf_ocr_desc">Resim olarak taranmış PDF\'leri arama ve kopyalama yapılabilir hale getirir.</string>

    <string name="tool_img_ocr">Resimden Yazı Okuma (OCR)</string>
    <string name="tool_img_ocr_desc">Fotoğraf veya taranmış resimlerdeki yazıları okuyup TXT olarak verir.</string>

    <string name="tool_split_pdf">PDF Sayfalarını Böl</string>
    <string name="tool_split_pdf_desc">Çok sayfalı PDF belgelerini her sayfası ayrı PDF olacak şekilde ZIP içinde verir.</string>

    <string name="tool_merge_pdf">Birden Fazla PDF\'i Birleştir</string>
    <string name="tool_merge_pdf_desc">İki ayrı PDF belgesini tek bir PDF dosyasında birleştirir.</string>

    <string name="tool_doc_create">Sıfırdan Zengin Belge Oluştur</string>
    <string name="tool_doc_create_desc">Metninizi zengin editörde yazın; Word, PDF, Markdown veya EPUB olarak kaydedin.</string>

